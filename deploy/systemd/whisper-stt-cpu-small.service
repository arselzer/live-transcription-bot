[Unit]
Description=Live Transcript ASR cpu-small
After=network.target
StartLimitIntervalSec=0
[Service]
WorkingDirectory=%h/live-transcription-bot
ExecStart=/usr/bin/python3 %h/live-transcription-bot/asr_service.py --device cpu-small
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
[Install]
WantedBy=default.target
