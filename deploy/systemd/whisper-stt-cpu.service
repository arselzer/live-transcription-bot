[Unit]
Description=Live Transcript ASR cpu-large
After=network.target
StartLimitIntervalSec=0
[Service]
WorkingDirectory=%h
ExecStart=%h/live-transcription-bot/.venv/bin/live-transcript serve asr --device cpu-large
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
[Install]
WantedBy=default.target
